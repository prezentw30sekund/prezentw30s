---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import ProductCard from '../../../components/ProductCard.astro';
import { okazje, osoby, osobyKatalog, budzety } from '../../../data/katalog';

// One template for the list /okazja/osoba/ and its budget sub-lists /okazja/osoba/do-100-zl/.
// Every quiz combination gets a page; one without a list file shows "w przygotowaniu" with noindex.
export async function getStaticPaths() {
  const listy = await getCollection('listy');
  return okazje.flatMap((o) =>
    osoby.flatMap((s) => {
      const lista = listy.find((l) => l.data.okazja === o.slug && l.data.osoba === s.slug);
      return [undefined, ...budzety.map((b) => b.slug)].map((b) => ({
        params: { okazja: o.slug, osoba: s.slug, budzet: b },
        props: {
          lista: lista && (!b || lista.data.podstronyBudzetu.includes(b)) ? lista : undefined,
          wszystkie: listy,
          budzetSlug: b,
        },
      }));
    }),
  );
}

const { lista, wszystkie, budzetSlug } = Astro.props;
const { okazja: okazjaSlug, osoba: osobaSlug } = Astro.params;
const d = lista?.data;
const Content = lista && (await render(lista)).Content;
const okazja = okazje.find((o) => o.slug === okazjaSlug)!;
const budzet = budzety.find((b) => b.slug === budzetSlug);
const listaUrl = `/${okazjaSlug}/${osobaSlug}/`;
const url = (l: NonNullable<typeof lista>) => `/${l.data.okazja}/${l.data.osoba}/`;
const zl = new Intl.NumberFormat('pl-PL', { style: 'currency', currency: 'PLN', maximumFractionDigits: 0 });

const produkty = !d ? [] : budzet ? d.produkty.filter((p) => p.cena > budzet.od && p.cena <= budzet.do) : d.produkty;
if (lista && produkty.length === 0) throw new Error(`${lista.id}: podstrona ${budzetSlug} nie ma produktów w tym budżecie`);
const h1 = [d ? d.h1 : `Prezent na ${okazja.nazwa} ${osobyKatalog[osobaSlug!].toLowerCase()}`, budzet?.nazwa.toLowerCase()].filter(Boolean).join(' ');
// A budget sub-list with under 3 products is too thin for Google (decyzje.md, PRE-18).
const noindex = !d || d.szkic || (budzet !== undefined && produkty.length < 3);
const ceny = produkty.map((p) => p.cena);
const [min, max] = [Math.min(...ceny), Math.max(...ceny)];
// Only lists that exist, so no related link ever leads to a 404.
const powiazane = d ? wszystkie.filter((l) => l.id !== lista.id && (l.data.okazja === d.okazja || l.data.osoba === d.osoba)) : [];
const podstrony = d ? budzety.filter((b) => d.podstronyBudzetu.includes(b.slug)) : [];
// Same trail as the visible crumbs below.
const okruszki = [['Strona główna', '/'], [okazja.nazwa, `/${okazja.slug}/`], [osobyKatalog[osobaSlug!], listaUrl], ...(budzet ? [[budzet.nazwa, `${listaUrl}${budzet.slug}/`]] : [])];
const schema = noindex ? undefined : {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: okruszki.map(([name, sciezka], i) => ({ '@type': 'ListItem', position: i + 1, name, item: new URL(sciezka, Astro.site).href })),
};
---
<Base title={d && !budzet ? d.tytul : `${h1} | prezentw30s.pl`} description={d?.opis ?? `${h1}: lista w przygotowaniu.`} noindex={noindex} schema={schema}>
  <nav class="crumbs" aria-label="Okruszki">
    <ol>
      <li><a href="/">Strona główna</a></li>
      <li><a href={`/${okazja.slug}/`}>{okazja.nazwa}</a></li>
      <li><a href={listaUrl} aria-current={budzet ? undefined : 'page'}>{osobyKatalog[osobaSlug!]}</a></li>
      {budzet && <li><a href={`${listaUrl}${budzet.slug}/`} aria-current="page">{budzet.nazwa}</a></li>}
    </ol>
  </nav>

  {!d && (
    <header class="head">
      <h1>{h1}</h1>
      <p class="intro">Tę listę jeszcze składamy: wybieramy prezenty i sprawdzamy ceny. Zajrzyj za kilka dni albo zmień odpowiedzi w quizie.</p>
      <p><a class="btn go" href="/">Wróć do quizu<svg aria-hidden="true"><use href="#i-go" /></svg></a></p>
    </header>
  )}

  {d && Content && (<>
  <header class="head">
    <h1>{h1}</h1>
    <div class="intro"><Content /></div>
    <p class="byline">Autor: {d.autor} · aktualizacja: {d.aktualizacja}</p>
    <p class="disclosure">Linki do sklepów są afiliacyjne: płacisz tyle samo, a sklep płaci nam prowizję. <a href="/jak-zarabiamy/">Jak zarabiamy</a></p>
  </header>

  <section class="sec" aria-labelledby="h-prop">
    <h2 id="h-prop">Propozycje</h2>

    <div class="tools">
      {min < max && (
        <div class="price" data-cena-filtr hidden>
          <label for="cena-do">Ile chcesz wydać? <output for="cena-do" data-wartosc>do {zl.format(max)}</output></label>
          <input id="cena-do" type="range" min={min} max={max} step="1" value={max} />
          <p class="count" aria-live="polite" data-licznik></p>
        </div>
      )}
      {(podstrony.length > 0 || budzet) && (
        <p class="budgets">
          {budzet && <a class="linkhand" href={url(lista)}>Wszystkie propozycje</a>}
          {podstrony.filter((b) => b !== budzet).map((b) => <a class="linkhand" href={`${url(lista)}${b.slug}/`}>Lista {b.nazwa.toLowerCase()}</a>)}
        </p>
      )}
    </div>

    <div class="cards">
      {produkty.map((p) => (
        <div class="item" data-cena={p.cena}>
          <ProductCard {...p} cena={zl.format(p.cena)} szczegoly={`/prezent/${p.goSlug}/`} />
        </div>
      ))}
    </div>
  </section>

  {d.faq.length > 0 && (
    <section class="sec" aria-labelledby="h-faq">
      <h2 id="h-faq">Pytania</h2>
      <div class="faq">
        {d.faq.map((f) => (
          <details class="sk">
            <summary>{f.pytanie}<svg aria-hidden="true"><use href="#i-go" /></svg></summary>
            <p>{f.odpowiedz}</p>
          </details>
        ))}
      </div>
    </section>
  )}

  {powiazane.length > 0 && lista && (
    <section class="sec" aria-labelledby="h-pow">
      <h2 id="h-pow">Powiązane listy</h2>
      <ul class="rel">
        {powiazane.map((l) => (
          <li><a href={url(l)}><span>{l.data.h1}</span><svg aria-hidden="true"><use href="#i-go" /></svg></a></li>
        ))}
      </ul>
    </section>
  )}
  </>)}
</Base>

<script>
  // Price slider: hides cards above the chosen amount. Without JS the slider stays hidden and every card shows.
  const box = document.querySelector<HTMLElement>('[data-cena-filtr]');
  if (box) {
    const input = box.querySelector('input')!;
    const out = box.querySelector('[data-wartosc]')!;
    const licznik = box.querySelector('[data-licznik]')!;
    const items = [...document.querySelectorAll<HTMLElement>('.cards [data-cena]')];
    const zl = new Intl.NumberFormat('pl-PL', { style: 'currency', currency: 'PLN', maximumFractionDigits: 0 });
    const zUrl = Number(new URL(location.href).searchParams.get('do'));
    if (zUrl > 0) input.value = String(zUrl); // the browser clamps it to min/max

    const pokaz = () => {
      const limit = Number(input.value);
      let widac = 0;
      for (const el of items) widac += Number(!(el.hidden = Number(el.dataset.cena) > limit));
      out.textContent = `do ${zl.format(limit)}`;
      licznik.textContent = `Widzisz ${widac} z ${items.length} propozycji`;
    };
    input.addEventListener('input', pokaz);
    // Remember the amount in the URL once the user lets go, so the link can be shared.
    input.addEventListener('change', () => {
      const u = new URL(location.href);
      if (input.value === input.max) u.searchParams.delete('do');
      else u.searchParams.set('do', input.value);
      history.replaceState(null, '', u);
    });
    box.hidden = false;
    pokaz();
  }
</script>

<style>
  .byline { font: 700 16px var(--hand); }

  .tools { display: grid; gap: 14px 40px; margin-top: 28px; align-items: end; }
  @media (min-width: 900px) { .tools { grid-template-columns: minmax(0, 420px) auto; } }
  .price { display: grid; gap: 6px; }
  .price[hidden] { display: none; }
  .price label { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 12px; font: 700 18px var(--hand); }
  .price output { font: 600 17px var(--text); font-variant-numeric: tabular-nums; }
  .count { font-size: 15px; color: var(--ink-2); font-variant-numeric: tabular-nums; }
  .budgets { display: flex; flex-wrap: wrap; gap: 0 22px; }

  /* Track is a marker line; the thumb is a yellow blob in the action colour. No mask on the track: in WebKit it would clip the thumb. */
  input[type='range'] { appearance: none; -webkit-appearance: none; width: 100%; height: 44px; margin: 0; background: transparent; cursor: pointer; }
  input[type='range']::-webkit-slider-runnable-track { height: 3px; background: var(--ink); border-radius: 2px; }
  input[type='range']::-moz-range-track { height: 3px; background: var(--ink); border-radius: 2px; }
  input[type='range']::-webkit-slider-thumb { -webkit-appearance: none; width: 30px; height: 30px; margin-top: -13.5px; background: var(--yellow); border: 2.5px solid var(--ink); border-radius: 50% 46% 52% 44% / 48% 52% 44% 50%; }
  input[type='range']::-moz-range-thumb { width: 26px; height: 26px; background: var(--yellow); border: 2.5px solid var(--ink); border-radius: 50% 46% 52% 44% / 48% 52% 44% 50%; }
  input[type='range']:focus-visible { outline-offset: 0; }

  .faq { display: grid; gap: 12px; margin-top: 28px; max-width: 760px; }
  .faq details { background: var(--paper); }
  .faq details:nth-child(2n) { border-radius: var(--wob2); }
  .faq summary { list-style: none; display: flex; align-items: center; justify-content: space-between; gap: 14px; min-height: 52px; padding: 10px 16px; font: 700 18px/1.3 var(--hand); cursor: pointer; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary svg { width: 22px; height: 22px; flex: none; transform: rotate(90deg); transition: transform 0.3s var(--ease); }
  .faq details[open] summary svg { transform: rotate(-90deg); }
  .faq summary:hover { background: var(--yellow-soft); border-radius: inherit; }
  .faq details p { padding: 0 16px 16px; max-width: 65ch; }

</style>
