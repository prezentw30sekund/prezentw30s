---
import '@fontsource-variable/shantell-sans/full.css';
import '@fontsource/figtree/latin-ext-400.css';
import '@fontsource/figtree/latin-ext-600.css';
import '@fontsource/figtree/latin-ext-700.css';
import '../styles/global.css';
import Ikony from '../components/Ikony.astro';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="pl_PL" />
    <!-- Before first paint, so a saved choice never flashes the other theme. -->
    <script is:inline>try { const t = localStorage.getItem('motyw'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch {}</script>
  </head>
  <body>
    <Ikony />
    <div class="wrap">
      <header class="hdr">
        <a class="logo" href="/">
          <svg aria-hidden="true"><use href="#face" /></svg>
          <span><b>prezentw30s.pl</b><small>Prezent w 30 sekund</small></span>
        </a>
        <nav class="nav" aria-label="Główne">
          <a href="/#katalog">Katalog</a>
          <a href="/#jak-to-dziala">Jak to działa</a>
          <a href="/jak-zarabiamy/">Jak zarabiamy</a>
        </nav>
        <details class="menu">
          <summary>Menu</summary>
          <ul class="sk">
            <li><a href="/#katalog">Katalog</a></li>
            <li><a href="/#jak-to-dziala">Jak to działa</a></li>
            <li><a href="/jak-zarabiamy/">Jak zarabiamy</a></li>
          </ul>
        </details>
        <button class="theme" type="button" aria-pressed="false" aria-label="Ciemny motyw" title="Ciemny motyw">
          <svg aria-hidden="true"><use href="#i-moon" /></svg>
        </button>
      </header>

      <main>
        <slot />
      </main>

      <footer class="foot">
        <a href="/o-nas/">O nas</a>
        <a href="/jak-zarabiamy/">Jak zarabiamy</a>
        <a href="/kontakt/">Kontakt</a>
        <a href="/polityka-prywatnosci/">Polityka prywatności</a>
        <span>© prezentw30s.pl</span>
      </footer>
    </div>
    <Analytics />
  </body>
</html>

<script>
  // Default follows the system; a click pins the opposite theme and remembers it.
  const root = document.documentElement;
  const btn = document.querySelector<HTMLButtonElement>('.theme')!;
  const isDark = () => (root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')) === 'dark';
  const sync = () => btn.setAttribute('aria-pressed', String(isDark()));
  sync();
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', sync);
  btn.addEventListener('click', () => {
    const t = isDark() ? 'light' : 'dark';
    root.dataset.theme = t;
    try { localStorage.setItem('motyw', t); } catch {}
    sync();
  });
</script>

<style>
  .hdr { display: flex; align-items: center; gap: 12px; padding-block: 14px; }
  .logo { margin-right: auto; display: flex; align-items: center; gap: 10px; text-decoration: none; }
  .logo svg { width: 46px; height: 46px; flex: none; }
  .logo b { display: block; font: 800 21px/1 var(--hand); }
  .logo small { display: block; font: 500 13px var(--hand); color: var(--ink-2); margin-top: 3px; }
  .nav { display: flex; gap: 4px; }
  .nav a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 12px; font: 700 17px var(--hand); text-decoration: none; border-radius: var(--wob2); }
  .nav a:hover { background: var(--yellow); color: var(--on-mark); }
  .theme { flex: none; display: grid; place-items: center; width: 44px; height: 44px; padding: 0; color: var(--ink); background: transparent; border: 2.5px solid var(--ink); border-radius: var(--wob2); cursor: pointer; }
  .theme svg { width: 26px; height: 26px; }
  .theme:hover { transform: translate(1px, 1px); }
  .theme[aria-pressed='true'] { background: var(--yellow); color: var(--on-mark); }
  .menu { display: none; position: relative; }
  .menu summary { list-style: none; min-height: 44px; padding: 0 16px; display: flex; align-items: center; font: 700 17px var(--hand); border: 2.5px solid var(--ink); border-radius: var(--wob2); cursor: pointer; }
  .menu summary::-webkit-details-marker { display: none; }
  .menu ul { position: absolute; right: 0; top: calc(100% + 8px); margin: 0; padding: 8px; list-style: none; background: var(--paper); min-width: 210px; z-index: 5; }
  .menu a { display: flex; align-items: center; min-height: 44px; padding: 0 10px; font: 700 17px var(--hand); text-decoration: none; }
  @media (max-width: 719px) {
    .nav { display: none; }
    .menu { display: block; }
    /* Logo + Menu + theme toggle must fit a 360 px phone. */
    .hdr { gap: 8px; }
    .logo { gap: 8px; }
    .logo svg { width: 40px; height: 40px; }
    .logo b { font-size: 18px; }
    .menu summary { padding: 0 12px; }
  }
  .foot { display: flex; flex-wrap: wrap; gap: 0 22px; padding-top: 20px; font: 500 16px var(--hand); }
  .foot a, .foot span { display: inline-flex; align-items: center; min-height: 44px; text-decoration: none; }
  .foot span { color: var(--ink-2); }
</style>
